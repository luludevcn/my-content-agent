{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@health-content-ai/agents": ["../../packages/agents/src"],
      "@health-content-ai/prompts": ["../../packages/prompts/src"],
      "@health-content-ai/markdown": ["../../packages/markdown/src"],
      "@health-content-ai/shared": ["../../packages/shared/src"],
      "@health-content-ai/rag": ["../../packages/rag/src"],
      "@health-content-ai/seo": ["../../packages/seo/src"],
      "@health-content-ai/medical": ["../../packages/medical/src"],
      "@health-content-ai/embeddings": ["../../packages/embeddings/src"],
      "@health-content-ai/database": ["../../packages/database/src"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
